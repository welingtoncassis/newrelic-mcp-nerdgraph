# Copy to .env for local development. Never commit the real file.

# Required: New Relic User API key (https://one.newrelic.com/api-keys)
# Starts with the NRAK- prefix.
NEW_RELIC_API_KEY=replace-with-your-user-api-key

# Default accounts for tools called without explicit ids
NEW_RELIC_ACCOUNT_IDS=1234567

# US or EU
NEW_RELIC_REGION=US

# Query shaping
NEW_RELIC_DEFAULT_SINCE=30 MINUTES AGO
NEW_RELIC_MAX_RESULT_ROWS=200
NEW_RELIC_MAX_RESPONSE_CHARS=100000
NEW_RELIC_QUERY_TIMEOUT_SECONDS=30
NEW_RELIC_MAX_RETRIES=3

# Guardrails — leave the last two off unless you need them
NEW_RELIC_REDACT_SENSITIVE_VALUES=true
NEW_RELIC_ENABLE_RAW_NERDGRAPH=false
NEW_RELIC_ENABLE_MUTATIONS=false
